# Meta Model API key from dev.meta.ai > API keys
MODEL_API_KEY=

# Neon Postgres connection string (Vercel Marketplace integration sets it)
DATABASE_URL=

# Shared password for the optional site gate (proxy.ts). Set it locally too, so npm run dev:lan is not open on the Wi-Fi.
# Use a random passphrase of 4 or more words.
SITE_PASSWORD=
# Set to exactly "off" to run the site open without the password (the public deployment does). Any other value keeps the gate.
SITE_GATE=

# Bearer secret for the daily purge cron (/api/cron/purge); Vercel sends it automatically. At least 16 random characters.
CRON_SECRET=

# Muse spend caps in USD (defaults shown): lifetime, site-wide per hour, per lobby creator IP per hour.
MUSE_BUDGET_USD=5
MUSE_HOURLY_USD=4
MUSE_CREATOR_HOURLY_USD=2

# UI: "racenight" makes the Race Night look the default; anything else is the classic look. ?ui= overrides per browser.
NEXT_PUBLIC_UI=racenight
